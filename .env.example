# Copy to .env and fill in. The .env file is never committed.
# Password for the dashboard (user name can be anything). Leave empty and the dashboard stays disabled.
PING_PASSWORD=
# Where alerts go: your private ntfy topic. Pick a long random name, install the ntfy app and subscribe to it.
# Example: https://ntfy.sh/xt-ping-7h3k9q2m5d
NTFY_URL=
# Optional tuning (defaults shown)
# FAILS_BEFORE_ALERT=2
# DISK_ALERT_PERCENT=85
# BACKUP_MAX_HOURS=26
